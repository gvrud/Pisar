<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Pisar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryContainer">@color/brand_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="Theme.Pisar" parent="Base.Theme.Pisar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Pisar.Splash" parent="Base.Theme.Pisar">
        <item name="android:windowBackground">@color/parchment</item>
        <item name="android:statusBarColor">@color/parchment</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Pisar.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert" />
</resources>
